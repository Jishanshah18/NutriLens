# NutriLens Frontend Environment Variables

# Backend API Service URL
EXPO_PUBLIC_API_URL=https://nutrilens-jfiv.onrender.com/api
# For local development:
# EXPO_PUBLIC_API_URL=http://127.0.0.1:8000/api

# Firebase Authentication (Obtain from Firebase Console > Project Settings > Web App config)
EXPO_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
EXPO_PUBLIC_FIREBASE_APP_ID=your_web_app_id
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id_optional

# Supabase Cloud Database (Preserves persistent scan history and user profiles)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
