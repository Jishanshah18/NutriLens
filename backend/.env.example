# NutriLens Backend Environment Variables
PORT=8000
ALLOWED_ORIGINS=http://localhost:8081,https://nutrilens.vercel.app

# Firebase Project Configuration (Matches Frontend Project ID for token verification)
FIREBASE_PROJECT_ID=your-firebase-project-id

# Supabase Cloud Database (Matches Frontend Supabase project)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here
